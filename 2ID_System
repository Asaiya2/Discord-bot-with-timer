    @commands.command(name='id')
    async def id_command(self, ctx, *, target: str = None):
        """Get IDs or view profiles of users, server, or channel.
        Usage: !id @user | !id username | !id server | !id channel | !id profile @user
        
        ⚠️ This command does NOT work in the MLBB server. Use !mlid instead.
        """
        if await self.check_duplicate(ctx):
            return
        
        # Disable on MLBB server
        if ctx.guild and ctx.guild.id == MLBB_SERVER_ID:
            await ctx.send("❌ The `!id` command is disabled in the MLBB server. Please use `!mlid` instead.")
            return
        
        # Delete the command message
        try:
            await ctx.message.delete()
        except:
            pass
            
        # If no target provided, show help
        if target is None:
            embed = discord.Embed(
                title="🆔 ID Command Help",
                description="Get IDs or view profiles.",
                color=discord.Color.blue()
            )
            embed.add_field(name="Basic ID Commands", 
                          value="`!id @user` - Get user's Discord ID or profile\n`!id username` - Get user ID by name\n`!id server` - Get server ID or profile\n`!id channel` - Get channel ID or profile", 
                          inline=False)
            embed.add_field(name="Profile Commands", 
                          value="`!id profile @user` - View user's ID profile\n`!id profile` - View your own profile", 
                          inline=False)
            embed.add_field(name="Global Profile", 
                          value="`!gid @user` - View a user's global profile (if they are the global user)", 
                          inline=False)
            await ctx.send(embed=embed)
            return
        
        # Check for profile view
        if target.lower().startswith('profile'):
            parts = target.split()
            if len(parts) > 1 and len(ctx.message.mentions) > 0:
                user = ctx.message.mentions[0]
            else:
                user = ctx.author
            
            await self.show_profile(ctx, user)
            return
        
        # Check for server profile or ID
        if target.lower() == 'server':
            # Try to show server profile first
            if await self.show_server_profile(ctx):
                return
            # Fall back to simple message
            await ctx.send(f"❌ This server does not have a profile.\nBut its Discord ID is: `{ctx.guild.id}`")
            return
        
        # Check for channel profile or ID
        if target.lower() == 'channel':
            # Try to show channel profile first
            if await self.show_channel_profile(ctx, ctx.channel):
                return
            # Fall back to simple message
            await ctx.send(f"❌ This channel does not have a profile.\nBut its Discord ID is: `{ctx.channel.id}`")
            return
        
        # Try to get user by mention or name
        try:
            user = None
            
            # Check if it's a mention
            if len(ctx.message.mentions) > 0:
                user = ctx.message.mentions[0]
            else:
                # Try to find user by exact name or nickname first
                target_lower = target.lower()
                for member in ctx.guild.members:
                    if member.name.lower() == target_lower:
                        user = member
                        break
                    if member.nick and member.nick.lower() == target_lower:
                        user = member
                        break
                
                # If not found, try partial match
                if not user:
                    for member in ctx.guild.members:
                        if target_lower in member.name.lower():
                            user = member
                            break
                        if member.nick and target_lower in member.nick.lower():
                            user = member
                            break
            
            if user:
                await self.show_profile(ctx, user)
            else:
                await ctx.send(f"❌ Could not find user `{target}`")
                
        except Exception as e:
            await ctx.send(f"❌ Error: {str(e)}")

    @commands.command(name='gid')
    async def global_id(self, ctx, *, target: str = None):
        """View a user's global profile (if they are the global user).
        Usage: !gid @user | !gid username | !gid
        """
        if await self.check_duplicate(ctx):
            return
        
        # Delete the command message
        try:
            await ctx.message.delete()
        except:
            pass
        
        # Determine target user
        user = None
        if target:
            # Check if it's a mention
            if len(ctx.message.mentions) > 0:
                user = ctx.message.mentions[0]
            else:
                # Try to find user by name
                target_lower = target.lower()
                for member in ctx.guild.members:
                    if member.name.lower() == target_lower:
                        user = member
                        break
                    if member.nick and member.nick.lower() == target_lower:
                        user = member
                        break
        else:
            user = ctx.author
        
        if not user:
