def _detect_media_type(url: str, content_type: str = "") -> str:
    """Return 'gif' | 'image' | 'unknown'. No video support."""
    lower = url.lower().split("?")[0]
    ct    = content_type.lower()

    # Giphy and Tenor are ALWAYS treated as gifs
    if "tenor.com" in lower or "giphy.com" in lower:
        return "gif"

    if ct == "image/gif" or lower.endswith(".gif"):
        return "gif"

    image_exts = (".png", ".jpg", ".jpeg", ".webp", ".bmp", ".tiff", ".avif")
    if ct.startswith("image/") or any(lower.endswith(e) for e in image_exts):
        return "image"

    return "unknown"


# ──────────────────────────────────────────────────────────────────────────────

class AbsoluteDetect(commands.Cog):
    def __init__(self, bot):
        self.bot = bot
        self.processed_commands = {}
        self.processed_messages = set()
        self.media_cooldowns = {}
        self.setup_database()
        print("✅ AbsoluteDetect cog initialized")

    # ── DATABASE SETUP ─────────────────────────────────────────────────────────

    def setup_database(self):
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()

            c.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='media_vault'")
            table_exists = c.fetchone()

            if not table_exists:
                c.execute("""
                    CREATE TABLE media_vault (
                        id           INTEGER PRIMARY KEY AUTOINCREMENT,
                        media_type   TEXT NOT NULL,
                        url          TEXT NOT NULL,
                        saved_by     TEXT NOT NULL,
                        saved_by_id  TEXT NOT NULL,
                        saved_at     REAL NOT NULL,
                        vault_msg_id TEXT,
                        keyword      TEXT
                    )
                """)
            else:
                c.execute("PRAGMA table_info(media_vault)")
                columns = [col[1] for col in c.fetchall()]
                if 'keyword' not in columns:
                    c.execute("ALTER TABLE media_vault ADD COLUMN keyword TEXT")

            c.execute("CREATE INDEX IF NOT EXISTS idx_keyword ON media_vault(keyword)")
            c.execute("CREATE TABLE IF NOT EXISTS vault_config (key TEXT PRIMARY KEY, value TEXT)")

            c.execute('''CREATE TABLE IF NOT EXISTS message_detections (
                             id INTEGER PRIMARY KEY AUTOINCREMENT,
                             guild_id TEXT NOT NULL,
                             trigger_text TEXT NOT NULL,
                             response_text TEXT NOT NULL,
                             created_by TEXT NOT NULL,
                             created_at REAL NOT NULL,
                             UNIQUE(guild_id, trigger_text)
                         )''')

            c.execute('''CREATE TABLE IF NOT EXISTS detection_logs (
                             id INTEGER PRIMARY KEY AUTOINCREMENT,
                             guild_id TEXT NOT NULL,
                             trigger_text TEXT NOT NULL,
                             response_text TEXT NOT NULL,
                             triggered_by TEXT NOT NULL,
                             triggered_in TEXT NOT NULL,
                             triggered_at REAL NOT NULL
                         )''')

            c.execute('''CREATE TABLE IF NOT EXISTS exempt_channels (
                             id INTEGER PRIMARY KEY AUTOINCREMENT,
                             guild_id TEXT NOT NULL,
                             channel_id TEXT NOT NULL,
                             added_by TEXT NOT NULL,
                             added_at REAL NOT NULL,
                             UNIQUE(guild_id, channel_id)
                         )''')

            conn.commit()
            conn.close()
            print("✅ Database initialized")
        except Exception as e:
            print(f"❌ Database error: {e}")

    # ── HELPER METHODS ─────────────────────────────────────────────────────────

    async def check_duplicate(self, ctx):
        key = f"{ctx.author.id}:{ctx.command.name}"
        now = time.time()
        last = self.processed_commands.get(key, 0)
        if now - last < 3:
            return True
        self.processed_commands[key] = now
        if len(self.processed_commands) > 100:
            self.processed_commands = {k: v for k, v in self.processed_commands.items() if now - v <= 10}
        return False

    def is_staff(self, member):
        if not isinstance(member, discord.Member):
            return False
        return any(r.name in STAFF_ROLES for r in member.roles)

    def is_owner_server(self, ctx):
        if not ctx.guild or ctx.guild.id != OWNER_SERVER_ID:
            return False
        return isinstance(ctx.author, discord.Member) and any(r.name == BOT_ROLE for r in ctx.author.roles)

    async def get_vault_channel(self):
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            c.execute("SELECT value FROM vault_config WHERE key = 'vault_channel_id'")
            row = c.fetchone()
            conn.close()
            if row and row[0]:
                guild = self.bot.get_guild(STORAGE_SERVER_ID)
                if guild:
                    ch = guild.get_channel(int(row[0]))
                    if ch:
                        return ch
        except Exception as e:
            print(f"Error: {e}")
        guild = self.bot.get_guild(STORAGE_SERVER_ID)
        if not guild:
            return None
        return discord.utils.get(guild.text_channels, name=VAULT_CHANNEL_NAME)

    def _check_media_cooldown(self, channel_id: int, media_type: str) -> float:
        cooldown_map = {"image": COOLDOWN_IMAGE, "gif": COOLDOWN_GIF}
        cooldown = cooldown_map.get(media_type, 2)
        key = f"{channel_id}:{media_type}"
        last = self.media_cooldowns.get(key, 0)
        elapsed = time.time() - last
        if elapsed < cooldown:
            return cooldown - elapsed
        return 0

    def _set_media_cooldown(self, channel_id: int, media_type: str):
        key = f"{channel_id}:{media_type}"
        self.media_cooldowns[key] = time.time()

    # ── DETECTOR DB METHODS ────────────────────────────────────────────────────

    def _load_detections(self, guild_id: int) -> dict:
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            c.execute("SELECT trigger_text, response_text, created_by, created_at FROM message_detections WHERE guild_id = ?",
                      (str(guild_id),))
            rows = c.fetchall()
            conn.close()
            result = {}
            for trigger, response, created_by, created_at in rows:
                result[trigger.lower()] = {
                    "response": response,
                    "original_trigger": trigger,
                    "created_by": int(created_by),
                    "created_at": created_at
                }
            return result
        except Exception as e:
            print(f"Error loading detections: {e}")
            return {}

    def _save_detection(self, guild_id: int, trigger: str, response: str, created_by: int) -> bool:
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            c.execute('''INSERT OR REPLACE INTO message_detections
                         (guild_id, trigger_text, response_text, created_by, created_at)
                         VALUES (?, ?, ?, ?, ?)''',
                      (str(guild_id), trigger, response, str(created_by), time.time()))
            conn.commit()
            conn.close()
            return True
        except Exception as e:
            print(f"Error saving detection: {e}")
            return False

    def _delete_detection(self, guild_id: int, trigger: str) -> bool:
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            c.execute("DELETE FROM message_detections WHERE guild_id = ? AND trigger_text = ?",
                      (str(guild_id), trigger))
            deleted = c.rowcount
            conn.commit()
            conn.close()
            return deleted > 0
        except Exception as e:
            print(f"Error deleting detection: {e}")
            return False

    def _log_detection(self, guild_id, trigger, response, user_id, channel_id):
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            c.execute('''INSERT INTO detection_logs
                         (guild_id, trigger_text, response_text, triggered_by, triggered_in, triggered_at)
                         VALUES (?, ?, ?, ?, ?, ?)''',
                      (str(guild_id), trigger, response, str(user_id), str(channel_id), time.time()))
            conn.commit()
            conn.close()
        except Exception as e:
            print(f"Error logging detection: {e}")

    def _save_exemption(self, guild_id, channel_id, added_by) -> bool:
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            c.execute('''INSERT OR IGNORE INTO exempt_channels (guild_id, channel_id, added_by, added_at)
                         VALUES (?, ?, ?, ?)''',
                      (str(guild_id), str(channel_id), str(added_by), time.time()))
            inserted = c.rowcount
            conn.commit()
            conn.close()
            return inserted > 0
        except Exception as e:
            print(f"Error saving exemption: {e}")
            return False

    def _delete_exemption(self, guild_id, channel_id) -> bool:
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            c.execute("DELETE FROM exempt_channels WHERE guild_id = ? AND channel_id = ?",
                      (str(guild_id), str(channel_id)))
            deleted = c.rowcount
            conn.commit()
            conn.close()
            return deleted > 0
        except Exception as e:
            print(f"Error deleting exemption: {e}")
            return False

    def _load_exemptions(self, guild_id: int) -> set:
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            c.execute("SELECT channel_id FROM exempt_channels WHERE guild_id = ?", (str(guild_id),))
            rows = c.fetchall()
            conn.close()
            return {int(r[0]) for r in rows}
        except:
            return set()

    # ── MEDIA VAULT DB METHODS ─────────────────────────────────────────────────

    def _get_all_entries(self, media_type: str = None):
        conn = sqlite3.connect(MAIN_DB_PATH)
        c = conn.cursor()
        if media_type:
            c.execute(
                "SELECT id, url, saved_by, saved_by_id, saved_at, vault_msg_id, keyword "
                "FROM media_vault WHERE media_type=? ORDER BY id ASC",
                (media_type,)
            )
        else:
            c.execute(
                "SELECT id, url, saved_by, saved_by_id, saved_at, vault_msg_id, keyword "
                "FROM media_vault ORDER BY id ASC"
            )
        rows = c.fetchall()
        conn.close()
        return rows

    def _get_entry_by_number(self, media_type: str, number: int):
        rows = self._get_all_entries(media_type)
        if 1 <= number <= len(rows):
            return rows[number - 1]
        return None

    def _get_next_id(self, media_type: str) -> int:
        return len(self._get_all_entries(media_type)) + 1

    def _update_vault_msg_id(self, db_id: int, msg_id: int):
        conn = sqlite3.connect(MAIN_DB_PATH)
        c = conn.cursor()
        c.execute("UPDATE media_vault SET vault_msg_id=? WHERE id=?", (str(msg_id), db_id))
        conn.commit()
        conn.close()

    def _get_entries_by_keyword(self, keyword: str):
        conn = sqlite3.connect(MAIN_DB_PATH)
        c = conn.cursor()
        c.execute(
            "SELECT id, media_type, url, saved_by, saved_by_id, saved_at, vault_msg_id, keyword "
            "FROM media_vault WHERE LOWER(keyword) = LOWER(?)",
            (keyword,)
        )
        rows = c.fetchall()
        conn.close()
        return rows

    def _save_media_db(self, media_type, url, saved_by, saved_by_id, keyword=None):
        conn = sqlite3.connect(MAIN_DB_PATH)
        c = conn.cursor()
        c.execute(
            "INSERT INTO media_vault (media_type, url, saved_by, saved_by_id, saved_at, keyword) VALUES (?,?,?,?,?,?)",
            (media_type, url, saved_by, saved_by_id, time.time(), keyword)
        )
        db_id = c.lastrowid
        conn.commit()
        conn.close()
        return db_id

    def _delete_entry(self, media_id: int):
        conn = sqlite3.connect(MAIN_DB_PATH)
        c = conn.cursor()
        c.execute("DELETE FROM media_vault WHERE id=?", (media_id,))
        conn.commit()
        conn.close()

    def _delete_all_entries(self, media_type: str):
        conn = sqlite3.connect(MAIN_DB_PATH)
        c = conn.cursor()
        c.execute("SELECT vault_msg_id FROM media_vault WHERE media_type=?", (media_type,))
        msg_ids = [row[0] for row in c.fetchall() if row[0]]
        c.execute("DELETE FROM media_vault WHERE media_type=?", (media_type,))
        conn.commit()
        conn.close()
        return msg_ids

    def _get_random_entry(self, media_type: str):
        rows = self._get_all_entries(media_type)
        return random.choice(rows) if rows else None

    def _type_display(self, media_type: str):
        return {
            "image": ("🖼️", "Image", "img"),
            "gif":   ("🎞️", "GIF",   "gif"),
        }.get(media_type, ("📎", media_type.title(), media_type))

    # ── MEDIA EXTRACTION ─────────────────────────────────────────────────────

    async def _extract_media(self, message: discord.Message):
        """
        Extract media from a message. Returns (url, 'image'|'gif').
        Giphy and Tenor links are ALWAYS treated as gifs.
        No video support.
        """
        # 1. Check raw content for giphy/tenor URL first (highest priority)
        for part in message.content.strip().split():
            if part.startswith("http"):
                if "giphy.com" in part.lower() or "tenor.com" in part.lower():
                    return part, "gif"

        # 2. Attachments
        if message.attachments:
            att   = message.attachments[0]
            ct    = att.content_type or ""
            mtype = _detect_media_type(att.url, ct)
            if mtype == "unknown":
                mtype = "gif" if att.filename.lower().endswith(".gif") else "image"
            return att.url, mtype

        # 3. Embeds
        if message.embeds:
            em = message.embeds[0]

            # If the embed's page URL is a giphy/tenor page, it's a gif
            embed_url = em.url or ""
            if "giphy.com" in embed_url.lower() or "tenor.com" in embed_url.lower():
                # Grab best available media URL from the embed
                media_url = (
                    (em.image.url   if em.image     else None) or
                    (em.thumbnail.url if em.thumbnail else None) or
                    (em.video.url   if em.video     else None)
                )
                if media_url:
                    return media_url, "gif"

            # Regular image embed
            if em.image and em.image.url:
                mtype = _detect_media_type(em.image.url)
                return em.image.url, mtype if mtype != "unknown" else "image"
            if em.thumbnail and em.thumbnail.url:
                mtype = _detect_media_type(em.thumbnail.url)
                return em.thumbnail.url, mtype if mtype != "unknown" else "image"

        # 4. Bare URL in content
        for part in message.content.strip().split():
            if part.startswith("http"):
                mtype = _detect_media_type(part)
                return part, mtype if mtype != "unknown" else "image"

        return None, None

    # ── ON_MESSAGE ────────────────────────────────────────────────────────────

    @commands.Cog.listener()
    async def on_message(self, message):
        if message.author.bot or not message.guild:
            return

        if message.id in self.processed_messages:
            return
        self.processed_messages.add(message.id)
        if len(self.processed_messages) > 500:
            self.processed_messages.clear()

        content = message.content.lower().strip()
        if not content or content.startswith('!'):
            return

        guild_id = message.guild.id

        # ===== SYSTEM 1: TEXT DETECTION =====
        exempt_channels = self._load_exemptions(guild_id)
        if message.channel.id not in exempt_channels:
            detections = self._load_detections(guild_id)
            if detections:
                for trigger, data in detections.items():
                    if trigger in content:
                        response = data["response"]
                        try:
                            await message.channel.send(response)
                            self._log_detection(guild_id, data["original_trigger"], response,
                                                message.author.id, message.channel.id)
                            try:
                                await message.add_reaction("🔍")
                            except:
                                pass
                        except Exception as e:
                            print(f"Detection send error: {e}")
                        break

        # ===== SYSTEM 2: MEDIA KEYWORD DETECTION =====
        all_media = self._get_all_entries()
        if all_media:
            matched = []
            for media in all_media:
                kw = media[6]
                if kw and kw.lower() in content:
                    matched.append(kw.lower())

            if matched:
                for keyword in list(set(matched)):
                    entries = self._get_entries_by_keyword(keyword)
                    if not entries:
                        continue

                    entry      = random.choice(entries)
                    media_type = entry[1]
                    media_url  = entry[2]

                    remaining = self._check_media_cooldown(message.channel.id, media_type)
                    if remaining > 0:
                        continue

                    try:
                        if media_type == "gif":
                            await message.channel.send(media_url)
                        else:
                            try:
                                async with aiohttp.ClientSession() as session:
                                    async with session.get(media_url) as resp:
                                        if resp.status == 200:
                                            data = await resp.read()
                                            filename = media_url.split("/")[-1].split("?")[0] or f"image_{entry[0]}.png"
                                            await message.channel.send(
                                                file=discord.File(fp=io.BytesIO(data), filename=filename)
                                            )
                                        else:
                                            await message.channel.send(media_url)
                            except:
                                await message.channel.send(media_url)

                        self._set_media_cooldown(message.channel.id, media_type)
                        try:
                            await message.add_reaction("🖼️")
                        except:
                            pass
                    except Exception as e:
                        print(f"Error sending keyword media: {e}")

    # ── CORE SAVE ────────────────────────────────────────────────────────────

    async def _do_save(self, ctx, url: str, media_type: str, keyword: str = None):
        vault_ch = await self.get_vault_channel()
        if not vault_ch:
            await ctx.send(f"❌ Vault channel not found. Run `!vaultsetup` in server `{STORAGE_SERVER_ID}`.")
            return

        number            = self._get_next_id(media_type)
        emoji, label, pfx = self._type_display(media_type)
        retrieve_cmd      = f"!{pfx} {number}"
        saved_by_str      = ctx.author.name if ctx.author.discriminator == "0" \
                            else f"{ctx.author.name}#{ctx.author.discriminator}"

        db_id  = self._save_media_db(media_type, url, saved_by_str, str(ctx.author.id), keyword)
        header = f"{emoji} **{label} #{number}** | Saved by **{saved_by_str}** | Use: `{retrieve_cmd}`"
        if keyword:
            header += f" | Keyword: `{keyword}`"

        vault_msg = None

        if media_type == "gif":
            await vault_ch.send(url)
            vault_msg = await vault_ch.send(header)
        else:
            try:
                async with aiohttp.ClientSession() as session:
                    async with session.get(url) as resp:
                        if resp.status == 200:
                            data = await resp.read()
                            filename = url.split("/")[-1].split("?")[0] or f"image_{number}.png"
                            vault_msg = await vault_ch.send(
                                content=header,
                                file=discord.File(fp=io.BytesIO(data), filename=filename)
                            )
                        else:
                            embed = discord.Embed(title=f"{label} #{number}", color=discord.Color.blurple())
                            embed.set_image(url=url)
                            embed.set_footer(text=f"Saved by {saved_by_str} | Use: {retrieve_cmd}")
                            vault_msg = await vault_ch.send(content=header, embed=embed)
            except:
                embed = discord.Embed(title=f"{label} #{number}", color=discord.Color.blurple())
                embed.set_image(url=url)
                embed.set_footer(text=f"Saved by {saved_by_str} | Use: {retrieve_cmd}")
                vault_msg = await vault_ch.send(content=header, embed=embed)

        self._update_vault_msg_id(db_id, vault_msg.id)

        confirm = discord.Embed(
            title=f"{emoji} {label} Saved!",
            color=discord.Color.green(),
            timestamp=datetime.utcnow()
        )
        confirm.add_field(name="Number",        value=f"`#{number}`",      inline=True)
        confirm.add_field(name="Retrieve with", value=f"`{retrieve_cmd}`", inline=True)
        confirm.add_field(name="Saved by",      value=ctx.author.mention,  inline=True)
        if keyword:
            confirm.add_field(name="Keyword", value=f"`{keyword}`", inline=True)
        confirm.set_footer(text="Stored in vault")
        await ctx.send(embed=confirm)

    # ── CORE SEND ────────────────────────────────────────────────────────────

    async def _send_media(self, ctx, media_type: str, number: int):
        if await self.check_duplicate(ctx):
            return

        remaining = self._check_media_cooldown(ctx.channel.id, media_type)
        if remaining > 0:
            await ctx.send(f"⏳ Please wait `{remaining:.1f}s` before sending another {media_type}.", delete_after=3)
            return

        row = self._get_entry_by_number(media_type, number)
        if not row:
            await ctx.send(f"❌ No {media_type} #{number} found.")
            return

        db_id, url, saved_by, saved_by_id, saved_at, vault_msg_id, keyword = row

        if media_type == "gif":
            await ctx.send(url)
        else:
            try:
                async with aiohttp.ClientSession() as session:
                    async with session.get(url) as resp:
                        if resp.status == 200:
                            data = await resp.read()
                            filename = url.split("/")[-1].split("?")[0] or f"image_{number}.png"
                            await ctx.send(file=discord.File(fp=io.BytesIO(data), filename=filename))
                        else:
                            await ctx.send(url)
            except:
                await ctx.send(url)

        self._set_media_cooldown(ctx.channel.id, media_type)

    # ── CORE DELETE ──────────────────────────────────────────────────────────

    async def _delete_media(self, ctx, media_type: str, number: int):
        if await self.check_duplicate(ctx):
            return
        all_entries = self._get_all_entries(media_type)
        if not (1 <= number <= len(all_entries)):
            await ctx.send(f"❌ No {media_type} #{number} found.")
            return

        target      = all_entries[number - 1]
        target_id   = target[0]
        target_url  = target[1]
        target_by   = target[2]
        target_vmid = target[5]
        emoji, label, pfx = self._type_display(media_type)

        vault_ch = await self.get_vault_channel()
        if vault_ch and target_vmid:
            try:
                msg = await vault_ch.fetch_message(int(target_vmid))
                await msg.delete()
                if media_type == "gif":
                    try:
                        url_msg = await vault_ch.fetch_message(int(target_vmid) - 1)
                        await url_msg.delete()
                    except:
                        pass
            except Exception as e:
                print(f"Delete error: {e}")

        self._delete_entry(target_id)

        remaining_entries = self._get_all_entries(media_type)
        updated = 0
        if vault_ch:
            for idx, entry in enumerate(remaining_entries, start=1):
                old_mid = entry[5]
                if old_mid:
                    try:
                        msg = await vault_ch.fetch_message(int(old_mid))
                        new_content = f"{emoji} **{label} #{idx}** | Saved by **{entry[2]}** | Use: `!{pfx} {idx}`"
                        if entry[6]:
                            new_content += f" | Keyword: `{entry[6]}`"
                        await msg.edit(content=new_content)
                        updated += 1
                        await asyncio.sleep(0.1)
                    except:
                        pass

        embed = discord.Embed(
            title=f"{emoji} {label} Deleted",
            description=f"Deleted **{label} #{number}**",
            color=discord.Color.red(),
            timestamp=datetime.utcnow()
        )
        embed.add_field(name="Saved by", value=target_by,                     inline=True)
        embed.add_field(name="URL",      value=f"[Click here]({target_url})", inline=True)
