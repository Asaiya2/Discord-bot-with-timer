    @commands.command(name='idsetglobal')
    async def idsetglobal(self, ctx):
        """Set yourself as the global profile user (DM only)"""
        if await self.check_duplicate(ctx):
            return
        
        # Only works in DMs
        if not isinstance(ctx.channel, discord.DMChannel):
            await ctx.send("❌ This command can only be used in DMs with the bot.")
            return
        
        # Check if there's already a global user
        if self.global_user_id is not None and self.global_user_id != ctx.author.id:
            await ctx.send("❌ There can only be ONE global profile user, and someone else already has it.")
            return
        
        # Check if user has a profile in any server
        has_profile = False
        for guild in self.bot.guilds:
            if guild.get_member(ctx.author.id):
                # Check if user_profiles table exists in this guild first
                if self.table_exists(guild.id, "user_profiles"):
                    conn = self.get_cached_connection(guild.id)
                    if conn:
                        c = conn.cursor()
                        c.execute("SELECT user_id FROM user_profiles WHERE user_id = ?", (str(ctx.author.id),))
                        if c.fetchone():
                            has_profile = True
                            break
        
        if not has_profile:
            await ctx.send("❌ You need to create at least one server profile first using verification or `!idset_users`.")
            return
        
        # Ask for confirmation
        await ctx.send("⚠️ This will make your profile GLOBAL across all servers. Only ONE person can have this. Type `CONFIRM` to continue.")
        
        def check(m):
            return m.author == ctx.author and m.channel == ctx.channel and m.content == "CONFIRM"
        
        try:
            await self.bot.wait_for('message', timeout=30.0, check=check)
            
            # Save to database
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            
            # Clear any existing global user
            c.execute("DELETE FROM global_profile")
            
            # Get user's info from first server profile
            display_name = "Unknown"
            join_reason = "Unknown"
            likes = "Unknown"
            
            for guild in self.bot.guilds:
                if guild.get_member(ctx.author.id):
                    if self.table_exists(guild.id, "user_profiles"):
                        conn2 = self.get_cached_connection(guild.id)
                        if conn2:
                            c2 = conn2.cursor()
                            c2.execute("SELECT display_name, join_reason, likes FROM user_profiles WHERE user_id = ?", (str(ctx.author.id),))
                            result = c2.fetchone()
                            if result:
                                display_name, join_reason, likes = result
                                break
            
            c.execute('''INSERT INTO global_profile
                         (user_id, display_name, join_reason, likes, created_at, updated_at)
                         VALUES (?, ?, ?, ?, ?, ?)''',
                      (str(ctx.author.id), display_name, join_reason, likes, time.time(), time.time()))
            
            conn.commit()
            conn.close()
            
            self.global_user_id = ctx.author.id
            
            embed = discord.Embed(
                title="🌍 Global Profile Activated!",
                description="You are now the ONE global profile user! Your profile will appear in all servers.",
                color=discord.Color.gold()
            )
            embed.add_field(name="Display Name", value=display_name, inline=True)
            embed.add_field(name="Join Reason", value=join_reason, inline=True)
            embed.add_field(name="Likes", value=likes, inline=True)
            
            await ctx.send(embed=embed)
            
        except asyncio.TimeoutError:
            await ctx.send("⏰ Timed out. Global profile setup cancelled.")

