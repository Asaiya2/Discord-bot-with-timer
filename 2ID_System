    async def show_profile(self, ctx, user):
        """Show a user's ID profile"""
        try:
            
            if not self.table_exists(ctx.guild.id, "user_profiles"):
                await ctx.send(f"❌ ID profiles haven't been set up in this server yet.\nBut {user.mention}'s Discord ID is: `{user.id}`")
                return
            
            conn = self.get_cached_connection(ctx.guild.id)
            if not conn:
                await ctx.send(f"❌ This server doesn't have ID profiles set up yet.\nBut {user.mention}'s Discord ID is: `{user.id}`")
                return
            
            c = conn.cursor()
            c.execute('''SELECT server_number, display_name, join_reason, likes, verified_at
                         FROM user_profiles WHERE user_id = ?''', (str(user.id),))
            result = c.fetchone()
            
            if not result:
                await ctx.send(f"❌ {user.mention} does not have an ID profile.\nBut their Discord ID is: `{user.id}`")
                return
            
            server_number, display_name, join_reason, likes, verified_at = result
            
            embed = discord.Embed(
                title=f"🆔 ID Profile: {user.name}",
                color=user.color if user.color.value != 0 else discord.Color.green()
            )
            embed.set_thumbnail(url=user.avatar.url if user.avatar else user.default_avatar.url)
            
            embed.add_field(name="Server ID #", value=f"`{server_number}`", inline=True)
            embed.add_field(name="Display Name", value=display_name, inline=True)
            embed.add_field(name="Verified", value=f"<t:{int(verified_at)}:R>", inline=True)
            embed.add_field(name="Join Reason", value=join_reason, inline=False)
            embed.add_field(name="Likes", value=likes, inline=False)
            
            # Check if this user has global profile
            if self.global_user_id == user.id:
