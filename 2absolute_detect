    @commands.command(name='detect_exempt')
    @commands.has_permissions(administrator=True)
    async def detect_exempt(self, ctx, *, args: str):
        """Exempt channels from detection. Usage: !detect_exempt #channel, #other"""
        raw_entries = [e.strip() for e in args.split(',')]
        added, already, invalid = [], [], []
        for entry in raw_entries:
            clean = entry.strip('<>#')
            try:
                channel_id = int(clean)
            except ValueError:
                invalid.append(entry); continue
            channel = ctx.guild.get_channel(channel_id)
            if not channel:
                invalid.append(entry); continue
            existing = self._load_exemptions(ctx.guild.id)
            if channel_id in existing:
                already.append(channel.mention)
            elif self._save_exemption(ctx.guild.id, channel_id, ctx.author.id):
                added.append(channel.mention)
            else:
                invalid.append(entry)
        lines = []
        if added:   lines.append(f"✅ **Exempted:** {', '.join(added)}")
        if already: lines.append(f"⚠️ **Already exempt:** {', '.join(already)}")
        if invalid: lines.append(f"❌ **Not found:** {', '.join(invalid)}")
        await ctx.send(embed=discord.Embed(
            title="🚫 Channel Exemptions Updated",
            description="\n".join(lines) or "Nothing changed.",
            color=discord.Color.orange()
        ))

