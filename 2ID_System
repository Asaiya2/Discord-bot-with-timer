    # ===== DUPLICATE PREVENTION =====
    async def check_duplicate(self, ctx):
        """Check if this command was already processed"""
        key = f"{ctx.author.id}:{ctx.command.name}"
        current_time = time.time()
        
        if key in self.processed_commands:
            if current_time - self.processed_commands[key] < 3:
                print(f"⚠️ Prevented dual execution: {ctx.command.name} by {ctx.author} in {ctx.guild.name}")
                return True
        
        self.processed_commands[key] = current_time
        
        if len(self.processed_commands) > 100:
            to_delete = [k for k, t in self.processed_commands.items() if current_time - t > 10]
            for k in to_delete:
                del self.processed_commands[k]
        
        return False

    # ===== DATABASE HELPERS =====
    def get_server_db_path(self, guild_id):
        """Get database path for a specific server"""
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            c.execute("SELECT db_path FROM authorized_servers WHERE guild_id = ?", (str(guild_id),))
            result = c.fetchone()
            
            if not result:
                c.execute("SELECT db_path FROM servers WHERE guild_id = ?", (str(guild_id),))
                result = c.fetchone()
            
            conn.close()
            
            if result and result[0]:
                return result[0]
            return None
        except Exception as e:
            print(f"Error getting server db path for {guild_id}: {e}")
            return None

    def get_cached_connection(self, guild_id):
        """Get cached database connection with proper error handling"""
        current_time = time.time()

        # Clean up old connections
        if hasattr(self.bot, 'db_connections') and len(self.bot.db_connections) > 10:
            for gid, last_used in list(self.bot.last_db_use.items()):
                if current_time - last_used > 300:
                    try:
                        if gid in self.bot.db_connections:
                            self.bot.db_connections[gid].close()
                            del self.bot.db_connections[gid]
                        del self.bot.last_db_use[gid]
                    except:
                        pass

        # Check existing connection
        if hasattr(self.bot, 'db_connections') and guild_id in self.bot.db_connections:
            try:
                self.bot.db_connections[guild_id].execute("SELECT 1")
                if hasattr(self.bot, 'last_db_use'):
                    self.bot.last_db_use[guild_id] = current_time
                return self.bot.db_connections[guild_id]
            except:
                try:
                    self.bot.db_connections[guild_id].close()
                except:
                    pass
                if guild_id in self.bot.db_connections:
                    del self.bot.db_connections[guild_id]

        # Get database path
        db_path = self.get_server_db_path(guild_id)
        if not db_path or not os.path.exists(db_path):
            print(f"❌ No valid db_path for guild {guild_id}")
            return None

        conn = sqlite3.connect(db_path)
        conn.row_factory = sqlite3.Row
        
        if not hasattr(self.bot, 'db_connections'):
            self.bot.db_connections = {}
        if not hasattr(self.bot, 'last_db_use'):
            self.bot.last_db_use = {}
            
        self.bot.db_connections[guild_id] = conn
        self.bot.last_db_use[guild_id] = current_time
        
        # Ensure tables exist on connection
        self.ensure_server_tables(guild_id)
        
        return conn

    # ===== DATABASE SETUP =====
    def setup_database(self):
        """Create necessary tables in main database"""
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            
            # Track global profile user
            c.execute('''CREATE TABLE IF NOT EXISTS global_profile
                         (user_id TEXT PRIMARY KEY,
                          display_name TEXT,
                          join_reason TEXT,
                          likes TEXT,
                          created_at REAL,
                          updated_at REAL)''')
            
            conn.commit()
            conn.close()
            print("✅ ID System database initialized")
        except Exception as e:
            print(f"❌ Error setting up ID database: {e}")

    def ensure_server_tables(self, guild_id):
        """Ensure server database has all profile tables"""
        try:
            conn = self.get_cached_connection(guild_id)
            if not conn:
                print(f"❌ ensure_server_tables: No connection for guild {guild_id}")
                return False
            
            c = conn.cursor()
            
            # User profiles
            c.execute('''CREATE TABLE IF NOT EXISTS user_profiles
                         (user_id TEXT PRIMARY KEY,
                          server_number INTEGER,
                          display_name TEXT,
                          join_reason TEXT,
                          likes TEXT,
                          verified_at REAL,
                          created_at REAL,
                          updated_at REAL)''')
            
            # Server profile (only one per server)
            c.execute('''CREATE TABLE IF NOT EXISTS server_profile
                         (guild_id TEXT PRIMARY KEY,
                          display_name TEXT,
                          description TEXT,
                          created_at REAL,
                          updated_at REAL,
                          created_by TEXT)''')
            
            # Channel profiles (one per channel)
            c.execute('''CREATE TABLE IF NOT EXISTS channel_profiles
                         (channel_id TEXT PRIMARY KEY,
                          display_name TEXT,
                          description TEXT,
                          created_at REAL,
                          updated_at REAL,
                          created_by TEXT)''')
            
            c.execute('''CREATE TABLE IF NOT EXISTS server_members
                         (user_id TEXT PRIMARY KEY,
                          join_order INTEGER,
                          joined_at REAL)''')
            
            conn.commit()
            return True
        except Exception as e:
            print(f"Error ensuring server tables for {guild_id}: {e}")
            return False

    def table_exists(self, guild_id, table_name):
        """Check if a table exists in the server database"""
        try:
            conn = self.get_cached_connection(guild_id)
            if not conn:
                return False
            c = conn.cursor()
            c.execute("SELECT name FROM sqlite_master WHERE type='table' AND name=?", (table_name,))
            return c.fetchone() is not None
        except:
            return False

    def get_server_number(self, guild_id, user_id):
        """Get or create server number for user (based on join order)"""
        try:
            conn = self.get_cached_connection(guild_id)
            if not conn:
                return None
            
            c = conn.cursor()
            
            # Check if user already has a number
            c.execute("SELECT server_number FROM user_profiles WHERE user_id = ?", (str(user_id),))
            result = c.fetchone()
            if result:
                return result[0]
            
            # Get the next available number
            c.execute("SELECT MAX(server_number) FROM user_profiles")
            result = c.fetchone()
            next_number = (result[0] or 0) + 1
            
            return next_number
        except Exception as e:
            print(f"Error getting server number: {e}")
            return None

    def load_global_user(self):
        """Load the global profile user from database"""
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            c.execute("SELECT user_id FROM global_profile LIMIT 1")
            result = c.fetchone()
            conn.close()
            return int(result[0]) if result else None
        except:
            return None

    def get_global_profile(self, user_id):
        """Get global profile data for a user"""
        try:
            conn = sqlite3.connect(MAIN_DB_PATH)
            c = conn.cursor()
            c.execute("SELECT display_name, join_reason, likes FROM global_profile WHERE user_id = ?", (str(user_id),))
            result = c.fetchone()
            conn.close()
            return result if result else None
        except:
            return None

    # ===== ID SETUP FLOW (Called after verification) =====
    async def start_id_setup(self, user, guild):
        """Start the ID setup process for a newly verified user"""
        # Ensure tables exist first
        self.ensure_server_tables(guild.id)
        
        # Check if user already has a profile in this server
        conn = self.get_cached_connection(guild.id)
        if conn:
            c = conn.cursor()
            c.execute("SELECT user_id FROM user_profiles WHERE user_id = ?", (str(user.id),))
            if c.fetchone():
                return  # User already has profile
        
        # Initialize setup tracking
        self.pending_setup[user.id] = {
            "guild_id": guild.id,
            "step": 1,
            "answers": {}
        }
        
        # Send first question
        try:
            embed = discord.Embed(
                title="📝 Create Your Server ID Card",
                description="Let's set up your ID card for this server! Answer these questions:",
                color=discord.Color.blue()
            )
            embed.add_field(name="Question 1/3", value="**Who are you?**\n*(This can be your name, nickname, or how you want to be known)*", inline=False)
            await user.send(embed=embed)
        except discord.Forbidden:
            print(f"❌ Cannot DM {user.name} for ID setup")

    # ===== LISTENERS =====
    @commands.Cog.listener()
    async def on_message(self, message):
        """Handle ID setup responses in DMs"""
        if message.author.bot or not isinstance(message.channel, discord.DMChannel):
            return
        
        user_id = message.author.id
        
        # Check for user profile setup
        if user_id in self.pending_setup:
            await self.handle_user_setup(message)
            return
        
        # Check for server profile setup
        if user_id in self.pending_server_setup:
            await self.handle_server_setup(message)
            return
        
        # Check for channel profile setup
        if user_id in self.pending_channel_setup:
            await self.handle_channel_setup(message)
            return

    async def handle_user_setup(self, message):
        """Handle user profile setup steps"""
        user_id = message.author.id
        setup_data = self.pending_setup[user_id]
        guild = self.bot.get_guild(setup_data["guild_id"])
        
        if not guild:
            del self.pending_setup[user_id]
            return
        
        if setup_data["step"] == 1:
            # Save answer to question 1
            setup_data["answers"]["display_name"] = message.content[:100]
            setup_data["step"] = 2
            
            embed = discord.Embed(
                title="📝 Question 2/3",
                description="**What do you want others to know about you?**",
                color=discord.Color.blue()
            )
            await message.channel.send(embed=embed)
            
        elif setup_data["step"] == 2:
            # Save answer to question 2
            setup_data["answers"]["join_reason"] = message.content[:200]
            setup_data["step"] = 3
            
            embed = discord.Embed(
                title="📝 Question 3/3",
                description="**What do you like?**\n*(Hobbies, interests, etc.)*",
                color=discord.Color.blue()
            )
            await message.channel.send(embed=embed)
            
        elif setup_data["step"] == 3:
            # Save final answer and create profile
            setup_data["answers"]["likes"] = message.content[:200]

            # Ensure tables exist before saving
            self.ensure_server_tables(guild.id)

            # Get database connection
            conn = self.get_cached_connection(guild.id)
            if not conn:
                await message.channel.send(
                    f"❌ Could not connect to the database for **{guild.name}**.\n"
                    f"Your answers were received but could not be saved.\n"
                    f"Please ask a server admin to check the bot's database configuration for this server."
                )
                print(f"❌ handle_user_setup: conn is None for guild {guild.id} ({guild.name}), user {user_id}")
                del self.pending_setup[user_id]
                return

            # Get server number
            server_number = self.get_server_number(guild.id, user_id)
            if server_number is None:
                await message.channel.send(
                    f"❌ Could not assign a server number for **{guild.name}**.\n"
                    f"Please ask a server admin to check the bot's database configuration."
                )
                del self.pending_setup[user_id]
                return

            # Save to database
            try:
                c = conn.cursor()
                c.execute('''INSERT OR REPLACE INTO user_profiles
                             (user_id, server_number, display_name, join_reason, likes, verified_at, created_at, updated_at)
                             VALUES (?, ?, ?, ?, ?, ?, ?, ?)''',
                          (str(user_id), server_number,
                           setup_data["answers"]["display_name"],
                           setup_data["answers"]["join_reason"],
                           setup_data["answers"]["likes"],
                           time.time(), time.time(), time.time()))
                conn.commit()

                print(f"✅ Profile saved for user {user_id} in guild {guild.id} ({guild.name}), server_number={server_number}")

                # Show completed profile
                embed = discord.Embed(
                    title="✅ ID Card Created!",
                    description=f"Your server ID card for **{guild.name}** has been created!",
                    color=discord.Color.green()
                )
                embed.add_field(name="Server ID #", value=f"`{server_number}`", inline=True)
                embed.add_field(name="Display Name", value=setup_data["answers"]["display_name"], inline=True)
                embed.add_field(name="Join Reason", value=setup_data["answers"]["join_reason"], inline=False)
                embed.add_field(name="Likes", value=setup_data["answers"]["likes"], inline=False)
                
                if guild.icon:
                    embed.set_thumbnail(url=guild.icon.url)
                
                await message.channel.send(embed=embed)
                
                # Log to server
                log_channel = await self.get_log_channel(guild)
                if log_channel:
                    await log_channel.send(f"📝 {message.author.mention} created their ID card (Server ID #{server_number})")

            except Exception as e:
                await message.channel.send(f"❌ Error saving your profile: {e}")
                print(f"❌ Error saving profile for {user_id} in guild {guild.id}: {e}")
            
            # Clean up
            del self.pending_setup[user_id]

