    @commands.command(name='detect_add')
    @commands.has_permissions(administrator=True)
    async def detect_add(self, ctx):
        """Interactively add a single message detection."""
        def check(m):
            return m.author == ctx.author and m.channel == ctx.channel

        try:
            await ctx.send(embed=discord.Embed(
                title="🔍 Add Detection — Step 1/2",
                description="What message should I detect?\n\n*Case-insensitive. Type `cancel` to cancel.*",
                color=discord.Color.blue()
            ))
            msg1 = await self.bot.wait_for('message', timeout=60.0, check=check)
            if msg1.content.lower() == 'cancel':
                await msg1.delete()
                await ctx.send("❌ Cancelled.")
                return
            trigger = msg1.content.strip()
            await msg1.delete()

            await ctx.send(embed=discord.Embed(
                title="🔍 Add Detection — Step 2/2",
                description=f"**Trigger:** `{trigger}`\n\nWhat should I respond with?\n\nType `cancel` to cancel.",
                color=discord.Color.blue()
            ))
            msg2 = await self.bot.wait_for('message', timeout=60.0, check=check)
            if msg2.content.lower() == 'cancel':
                await msg2.delete()
                await ctx.send("❌ Cancelled.")
                return
            response = msg2.content.strip()
            await msg2.delete()

            existing = self._load_detections(ctx.guild.id)
            if trigger.lower() in existing:
                await ctx.send(f"⚠️ A detection for `{trigger}` already exists! Remove it first with `!detect_remove {trigger}`.")
                return

            if self._save_detection(ctx.guild.id, trigger, response, ctx.author.id):
                await ctx.send(embed=discord.Embed(
                    title="✅ Detection Added",
                    description=f"When someone says **{trigger}**, I'll respond:\n> {response}",
                    color=discord.Color.green()
                ))
            else:
                await ctx.send("❌ Failed to save.")

        except asyncio.TimeoutError:
            await ctx.send("⏰ Timed out.")

    @commands.command(name='detect_multiple')
    @commands.has_permissions(administrator=True)
    async def detect_multiple(self, ctx):
        """Add multiple triggers that all share the same response."""
        def check(m):
            return m.author == ctx.author and m.channel == ctx.channel

        triggers = []

        try:
            await ctx.send(embed=discord.Embed(
                title="🔍 Multiple Detections — Step 1/2",
                description="Enter triggers one at a time.\nType `next` when done, `cancel` to cancel.\n*Case-insensitive*",
                color=discord.Color.blue()
            ))

            while True:
                current = ', '.join(f'`{t}`' for t in triggers) if triggers else "None"
                await ctx.send(f"**Current triggers ({len(triggers)}):** {current}\n\nEnter a trigger or `next`/`cancel`:")
                msg = await self.bot.wait_for('message', timeout=60.0, check=check)
                content = msg.content.strip()
                await msg.delete()

                if content.lower() == 'cancel':
                    await ctx.send("❌ Cancelled.")
                    return
                elif content.lower() == 'next':
                    if not triggers:
                        await ctx.send("⚠️ Add at least one trigger first.")
                        continue
                    break
                else:
                    if content.lower() in [t.lower() for t in triggers]:
                        await ctx.send(f"⚠️ `{content}` is already in the list.")
                        continue
                    triggers.append(content)
                    await ctx.send(f"✅ Added `{content}`")

            await ctx.send(embed=discord.Embed(
                title="🔍 Multiple Detections — Step 2/2",
                description=f"**Triggers:** {', '.join(f'`{t}`' for t in triggers)}\n\nWhat should I respond with?",
                color=discord.Color.blue()
            ))
            msg2 = await self.bot.wait_for('message', timeout=60.0, check=check)
            response = msg2.content.strip()
            await msg2.delete()

            existing = self._load_detections(ctx.guild.id)
            saved, skipped = 0, 0
            for trigger in triggers:
                if trigger.lower() in existing:
                    skipped += 1
                    continue
                if self._save_detection(ctx.guild.id, trigger, response, ctx.author.id):
                    saved += 1

            await ctx.send(embed=discord.Embed(
                title="✅ Multiple Detections Added",
                description=f"**Saved:** {saved} | **Skipped (already exist):** {skipped}\n\n**Response:** {response}",
                color=discord.Color.green()
            ))

        except asyncio.TimeoutError:
            await ctx.send("⏰ Timed out.")

