    @commands.command(name="save")
    async def save(self, ctx, *, keyword: str = None):
        """Save an image or GIF to the vault (staff only).
        Usage:
          !save                     — reply to a message with an image/GIF
          !save https://url         — direct link
          !save keyword             — reply to media + attach a keyword trigger
        """
        if await self.check_duplicate(ctx):
            return
        if not self.is_staff(ctx.author):
            await ctx.send("❌ Only staff can save media.")
            return

        url_from_arg = None
        if keyword:
            parts = keyword.split()
            for part in parts:
                if part.startswith("http"):
                    url_from_arg = part
                    remaining_kw = ' '.join(p for p in parts if not p.startswith("http")).strip()
                    keyword = remaining_kw or None
                    break

        source = ctx.message
        if ctx.message.reference:
            try:
                source = await ctx.channel.fetch_message(ctx.message.reference.message_id)
            except:
                pass

        url, media_type = await self._extract_media(source)

        if not url and url_from_arg:
            url = url_from_arg
            if "giphy.com" in url.lower() or "tenor.com" in url.lower():
                media_type = "gif"
            else:
                media_type = _detect_media_type(url)
                if media_type == "unknown":
                    media_type = "image"

        if not url:
            await ctx.send(
                "❌ Nothing to save!\n"
                "• Reply to a message with an image or GIF, then `!save`\n"
                "• Or: `!save https://link`\n"
                "• Or with keyword: `!save keyword` while replying to media"
            )
            return

        await self._do_save(ctx, url, media_type, keyword)

