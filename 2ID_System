    @commands.command(name='idset_users')
    @commands.has_permissions(administrator=True)
    async def idset_users(self, ctx):
        """DM all unregistered users to set up their ID profiles"""
        if await self.check_duplicate(ctx):
            return
        
        # Check for AsaiyaBot role
        has_bot_role = any(role.name == BOT_ROLE for role in ctx.author.roles)
        if not has_bot_role:
            await ctx.send(f"❌ You need the {BOT_ROLE} role to use this command.")
            return
        
        # Ensure tables exist
        self.ensure_server_tables(ctx.guild.id)
        
        status_msg = await ctx.send("📨 Scanning for users without ID profiles...")
        
        # Get all members without profiles
        conn = self.get_cached_connection(ctx.guild.id)
        if not conn:
            await status_msg.edit(content="❌ Could not connect to database.")
            return
        
        c = conn.cursor()
        
        # Get users who already have profiles
        c.execute("SELECT user_id FROM user_profiles")
        profiled_users = [row[0] for row in c.fetchall()]
        
        # Find members without profiles
        members_to_dm = []
        for member in ctx.guild.members:
            if member.bot:
                continue
            if str(member.id) not in profiled_users:
                members_to_dm.append(member)
        
        if not members_to_dm:
            await status_msg.edit(content="✅ All members already have ID profiles!")
            return
        
        await status_msg.edit(content=f"📨 Sending ID setup DMs to {len(members_to_dm)} members...")
        
        # Send DMs
        success = 0
        failed = 0
        
        for member in members_to_dm:
            try:
                embed = discord.Embed(
                    title="📝 Create Your Server ID Card",
                    description=(
                        f"Hello! The staff of **{ctx.guild.name}** would like you to create your server ID card.\n\n"
                        f"This helps everyone get to know each other better!"
                    ),
                    color=discord.Color.blue()
                )
                embed.add_field(name="What is this?", 
                              value="You'll answer 3 simple questions to create your profile.", 
                              inline=False)
                embed.add_field(name="Questions", 
                              value="1. Who are you?\n2. What do you want others to know about you?\n3. What do you like?", 
                              inline=False)
                
                await member.send(embed=embed)
                
                # Initialize setup for this user
                self.pending_setup[member.id] = {
                    "guild_id": ctx.guild.id,
                    "step": 1,
                    "answers": {}
                }
                
                # Send first question
                q_embed = discord.Embed(
                    title="📝 Question 1/3",
                    description="**Who are you?**\n*(This can be your name, nickname, or how you want to be known)*",
                    color=discord.Color.blue()
                )
                await member.send(embed=q_embed)
                
                success += 1
                await asyncio.sleep(1)  # Rate limiting
                
            except discord.Forbidden:
                failed += 1
                print(f"❌ Cannot DM {member.name}")
            except Exception as e:
                failed += 1
                print(f"Error DMing {member.name}: {e}")
        
        await status_msg.delete()
        
        embed = discord.Embed(
            title="📨 ID Setup Complete",
            description=f"**Success:** {success} DM(s) sent\n**Failed:** {failed} user(s) (DMs disabled)",
            color=discord.Color.green() if failed == 0 else discord.Color.orange()
        )
        await ctx.send(embed=embed)

